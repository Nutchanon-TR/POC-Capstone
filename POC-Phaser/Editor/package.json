{
  "name": "connecta-map-room",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "map:sync": "node scripts/sync-map.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src shared server scripts tests",
    "format": "prettier --write src shared server scripts tests",
    "format:check": "prettier --check src shared server scripts tests",
    "test": "node --import tsx --test tests/tool.test.mjs tests/interact.test.mjs tests/order.test.mjs tests/walk.test.mjs tests/kmutt-map.test.mjs tests/catalog.test.mjs tests/transform.test.mjs tests/studio-store.test.mjs tests/selection.test.mjs",
    "test:e2e": "playwright test",
    "test:studio": "playwright test --config playwright.studio.config.mjs",
    "db:setup": "node scripts/setup-database.mjs",
    "api:build": "tsc -p server/tsconfig.json",
    "api:dev": "tsx watch --tsconfig server/tsconfig.json server/main.ts",
    "api:start": "node server/dist/main.js",
    "test:api": "node --test tests/api.test.mjs tests/assets.test.mjs",
    "characters:prepare": "node scripts/prepare-characters.mjs",
    "voice:setup": "node scripts/setup-voice.mjs",
    "voice:up": "docker compose -f compose.voice.yaml up -d",
    "voice:down": "docker compose -f compose.voice.yaml down",
    "test:realtime": "node --test tests/realtime.test.mjs",
    "test:voice": "playwright test tests/browser/voice.spec.mjs"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "1.3.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/websockets": "11.2.7",
    "antd": "6.6.5",
    "fflate": "0.8.3",
    "livekit-client": "2.21.0",
    "livekit-server-sdk": "2.19.1",
    "next": "16.3.8",
    "pg": "8.23.1",
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
